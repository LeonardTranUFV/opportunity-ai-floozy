# ---------------------------------------------------------------
# Credentials for RUN-WORKER.bat / `npx tsx scripts/auto-scrape.ts --env .env.worker`
#
# These point at the PRODUCTION Supabase project — the same one the
# Vercel site reads — so that posts crawled on this machine show up in
# your customers' dashboards. That is the whole point of the worker.
#
# Copy this file to .env.worker and fill it in. .env.worker is
# gitignored: the service-role key bypasses every row-level security
# policy in the database, so it must never be committed, and never be
# exposed to a browser.
#
# Your ordinary .env stays untouched and keeps pointing at whatever you
# develop against.
# ---------------------------------------------------------------

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-prod-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# reddit.com/prefs/apps → create a "script" app. Needed for Reddit
# sources; the browser platforms don't use these.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Must be byte-for-byte the same value as SESSION_ENCRYPTION_KEY in Vercel.
#
# Customers connect Facebook/LinkedIn/Nextdoor/X on the hosted site, and their
# session is stored encrypted with that key. This worker is what later loads
# those sessions to crawl with, so a different key here means every hosted
# customer's source is silently skipped — the rows exist and decrypt to
# nothing. Copy the value, don't generate a second one.
SESSION_ENCRYPTION_KEY=

# AI for scoring and drafts (lib/ai-provider.ts). The worker tries, in
# order: your Claude Code login, your Codex login, the Claude API, Gemini.
# Any one of them lets the worker score posts for local-collection accounts
# itself, with no time limit and past the thousand-post cap of a hosted
# scan. With none, the worker only collects, and the hosted auto-scan scores
# agents that have auto-scan switched on.
#
# platform.claude.com → API keys. Scoring uses claude-haiku-5-5.
ANTHROPIC_API_KEY=
# aistudio.google.com/apikey. Last fallback.
GEMINI_API_KEY=
#
# Optional: change the order, or leave a provider out.
# AI_CHAIN_SCORING=claude-cli,codex-cli,claude-api,gemini
# AI_CHAIN_WRITING=claude-api,gemini
# Optional: models. Defaults: haiku (CLI), claude-haiku-5-5 (API).
# CLAUDE_CLI_MODEL=haiku
# CODEX_CLI_MODEL=
# CLAUDE_SCORING_MODEL=claude-haiku-5-5
# CLAUDE_WRITING_MODEL=claude-haiku-5-5

# Morning lead email (SEND-LEADS.bat / scripts/send-daily-leads.ts).
# GMAIL_APP_PASSWORD is a Google *app password* (myaccount.google.com →
# Security → 2-Step Verification → App passwords), not your normal password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# console.typesafe.ai/keys. Optional: Jev checks whether undated posts still
# read as an open request, and drops the ones that don't.
TYPESAFE_API_KEY=

# ---------------------------------------------------------------
# Apify — optional, for the alternative Facebook collection path
# (lib/apify-scraper.ts, compared by scripts/compare-apify.ts).
#
# Nothing uses these unless APIFY_TOKEN is set; the browser path is
# unaffected either way. Apify reads PUBLIC groups with no Facebook
# login at all, which is the point: a public source collected this way
# puts no customer account at risk and needs no session handling.
#
# Actors are priced per 1,000 results and vary by roughly two orders of
# magnitude ($0.08 to $7 per 1k at the time of writing), and they differ
# in both input shape and output field names. That is why the actor and
# its URL field are configurable rather than hardcoded — swapping one
# for another, or A/B-ing two over the same groups, must not need a
# deploy. Run scripts/compare-apify.ts to see what a given actor
# actually returns before trusting it.
# ---------------------------------------------------------------

# apify.com → Settings → Integrations → Personal API token
APIFY_TOKEN=

# Since step 3 of the shared-leads plan, Apify also reads Floozy's PUBLIC
# area groups from the hosted cron /api/cron/collect-areas (set these in
# Vercel too). Spending cap, all optional:
# APIFY_DAILY_RESULTS=1000        results per UTC day, every area together
# APIFY_RESULTS_PER_GROUP=25      results per group per read
# APIFY_GROUP_MIN_AGE_HOURS=6     don't re-read a public group sooner
# APIFY_SINCE_DAYS=3              only posts from the last N days

# Marketplace actor to run. Default: apify~facebook-groups-scraper
# APIFY_FACEBOOK_ACTOR=apify~facebook-groups-scraper

# The input field that actor expects its group URLs under. Default: startUrls
# APIFY_FACEBOOK_URL_FIELD=startUrls

# ---------------------------------------------------------------
# Floozy collects per area (step 3 of the shared-leads plan)
#
# Floozy's own accounts read the Facebook groups in each service area,
# so clients never connect Facebook. One app account per Floozy
# Facebook profile ("collector"). Set up each one with
#   npx tsx scripts/floozy-groups.ts setup --user <uuid>
#   npx tsx scripts/local-login.ts --env .env.worker --platform facebook --user <uuid>
# then load the area groups from a local, gitignored file:
#   npx tsx scripts/floozy-groups.ts load floozy-groups.local.json
#
# The same list goes in Vercel, so the cloud never opens these accounts.
# ---------------------------------------------------------------
FLOOZY_COLLECTOR_USER_IDS=

# Private area groups, read by this worker. Kept slow on purpose: these
# profiles now carry the ban risk. Defaults shown.
# FLOOZY_PC_GROUPS_PER_RUN=6
# FLOOZY_PC_GROUP_MIN_AGE_HOURS=8

# Vercel only, not this file: CLOUD_FACEBOOK=off stops the cloud reading
# any client's Facebook with their own login. Leave it on until clients
# get Floozy's area leads (step 4), or their Facebook leads stop.
